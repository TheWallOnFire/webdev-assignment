generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model StudentScore {
    sbd          String  @id @db.VarChar(8)
    toan         Float?
    ngu_van      Float?
    ngoai_ngu    Float?
    vat_li       Float?
    hoa_hoc      Float?
    sinh_hoc     Float?
    lich_su      Float?
    dia_li       Float?
    gdcd         Float?
    ma_ngoai_ngu String? @db.VarChar(2)

    created_at   DateTime @default(now())
    updated_at   DateTime @default(now()) @updatedAt

    @@map("student_scores")
}
